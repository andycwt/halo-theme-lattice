{
  "name": "halo-theme-lattice",
  "version": "0.1.0",
  "private": true,
  "description": "A clean, content-first Halo 2.x theme with configurable layout and colors.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "halo:up": "docker compose -f dev/docker-compose.yaml up -d --wait",
    "halo:down": "docker compose -f dev/docker-compose.yaml down",
    "halo:logs": "docker compose -f dev/docker-compose.yaml logs -f halo",
    "build": "pnpm typecheck && vite build",
    "package": "pnpm build && theme-package && node src/scripts/normalize-package.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,mjs,js,css,html,json,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "1.1.1",
    "@halo-dev/vite-plugin-halo-theme": "1.0.3",
    "adm-zip": "^0.6.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  }
}
